FROM node:22-alpine

WORKDIR /app

ARG NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8001/api/v1
ARG NEXT_PUBLIC_SALEOR_API_URL=http://127.0.0.1:8000/graphql/
ENV NEXT_PUBLIC_AI_API_URL=$NEXT_PUBLIC_AI_API_URL
ENV NEXT_PUBLIC_SALEOR_API_URL=$NEXT_PUBLIC_SALEOR_API_URL

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
