# ---- PostgreSQL（业务库，必填） ----
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ecommerce

# ---- Saleor 配置（必填） ----
SALEOR_DB=saleor
SALEOR_SECRET_KEY=change-me-random-secret

# ---- MinIO（可选默认） ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# ---- AI 扩展层（可选，容器内默认值已配置） ----
AI_DB=ai_platform

# ---- 店铺凭据加密（必填） ----
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORE_CREDENTIAL_KEY=change-me-fernet-key

# ---- Shopify Connector（可选；留空则 REAL_INTEGRATION: NOT_VERIFIED） ----
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# ---- 支付 Webhook 验签（必填） ----
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ---- 支付宝电脑网站支付（沙箱 / 正式均可；未配置时不能发起支付宝支付） ----
PAYMENT_PROVIDER=alipay
ALIPAY_GATEWAY_URL=https://openapi.alipaydev.com/gateway.do
ALIPAY_APP_ID=
# PEM 内容可写成单行并用 \\n 表示换行，也可由容器环境注入
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:8001/api/v1/finance/alipay/notify
ALIPAY_RETURN_URL=http://localhost:3000/payment/alipay/return

# Saleor 中安装支付宝 Payment App 后，将 gateway 标识改为该 App 的 gateway
NEXT_PUBLIC_SALEOR_PAYMENT_GATEWAY=mirumee.payments.dummy

# ---- LLM / Embedding（可选；留空则 AI 接口返回 503，RAG 使用本地哈希嵌入） ----
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small

# ---- 日志级别（可选；dev 默认 DEBUG，其他默认 INFO） ----
LOG_LEVEL=
